<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aurum.crm</groupId>
        <artifactId>aurum-crm</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>crm-module-system</artifactId>
    <packaging>jar</packaging>
    <name>crm-module-system</name>
    <description>系统模块：用户、角色、部门、菜单、字典、编号规则、日志</description>

    <dependencies>

        <dependency>
            <groupId>com.aurum.crm</groupId>
            <artifactId>crm-security</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.aurum.crm</groupId>
            <artifactId>crm-mybatis</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 阿里云 OSS SDK：文件上传能力（POST /system/file/upload） -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <!--
            AOP：操作日志切面（OperationLogAspect）。

            ⚠️ 这是本项目的**第一个** AOP 依赖 —— 在此之前全项目没有 @Aspect、
            也没有任何自定义注解。之所以加在 crm-module-system 而不是 crm-common：
            切面要把记录写进 sys_operation_log，那是本模块的表，
            而 crm-common 是被所有模块依赖的最底层，依赖不到 system。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            邮件：邮箱验证码（注册 / 登录 / 找回密码）。
            提供 JavaMailSender，配置见 crm-server 的 application-dev.yml 的 spring.mail.*。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
