# ============================================================================
#  AurumCRM 生产环境变量模板
#
#  ⚠️⚠️⚠️ 【这是一个模板，不是能直接跑的配置】
#
#      它语法没问题（可以 source），但值全是 <...> 占位符。
#      直接 cp 成 env 去启动，必挂 —— 而且挂得很误导：
#
#        service.sh 的必填校验只查「变量空不空」，而 '<改成真实密码>' 是非空的，
#        于是校验【全绿通过】，服务开始启动，然后连 MySQL 报
#          Access denied for user 'root'
#        错误指向"密码错"，你就去核对密码 —— 而真正的原因是密码压根没填。
#
#      ⇒ 启动前请确认下面每一个 <...> 都已经换成真实值。
#
#  ─────────────────────────────────────────────────────────────────────
#
#  【推荐用法】部署第一台：从头填一遍（下面每一项都写了从哪拿）。
#
#  【强烈推荐】部署第二台 / 加机器：**不要用这个模板**，去拷第一台那份填好的。
#
#      scp root@<第一台>:/root/CRM/aurum-crm/env /root/CRM/aurum-crm/env
#      chmod 600 env && vi env        # 只需要改 DB_HOST / REDIS_HOST 两行
#
#      理由：18 项里有 6 个是凭证，手抄极容易漏项。
#      漏了报 `Could not resolve placeholder`；漏错一个值则可能【静默连到错的库】。
#      详见 docs/12-集群部署清单.md 第三节。
#
#  ─────────────────────────────────────────────────────────────────────
#
#  文件名必须是 env —— service.sh:39 找的就是 $WORK_DIR/env 这个确切名字。
#  不叫 .env、不叫 env.prod，也【不需要执行权限】（它是被 source 的，不是被运行的）。
#
#  ⚠️⚠️ 填好真值的 env 文件【绝对不要提交到 git】。
#      这个模板本身是安全的（全是占位符），但填好真值的那份不是。
#      服务器的 /root/CRM/aurum-crm/ 目录不在 git 仓库里，别手滑 cp 回本地仓库。
#
#  ⚠️⚠️ 每个值都必须用【单引号】包起来。
#      这个文件是被 bash 用 `source` 执行的，不是被解析的 ——
#      裸值里如果含 $、反引号、空格、#，会被变量展开甚至当成命令执行。
#      例如：DB_PASSWORD='YourStrongPassword!123'  ✅
#            DB_PASSWORD=YourStrongPassword123    ✅（恰好没特殊字符，侥幸）
#            DB_PASSWORD=abc$123                   ❌ 会变成 abc123（$1 被展开）
#
#  ⚠️ 编辑这个文件【不要用会写 CRLF 的 Windows 工具】。
#      尾部的 \r 会让密码变成 "xxxx\r"，报 Access denied，
#      而屏幕上看起来密码完全正确。service.sh 启动时会检测并拒绝。
#
#  值从哪来：application-dev.yml 里有同样的配置项，可以直接对照抄过来。
# ============================================================================


# ============================================================================
#  应用基本配置
# ============================================================================
# 固定为 prod。这一项决定了上面那些占位符会被 application-prod.yml 读取
SPRING_PROFILES_ACTIVE='prod'


# ============================================================================
#  【必填】MySQL
#
#  地址与端口自 2026-09-15 起是变量，application-prod.yml 里对应的 url 是：
#      jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/crm?useUnicode=true&...
#  —— 不填 DB_HOST 就默认走回环（单机部署下最快最稳，推荐保持）。
#
#  ⚠️ 用 IP 而不是 localhost：localhost 可能先解析到 ::1，
#     会对着一个明明活着的数据库报 Connection refused。
#
#  ⚠️ 做集群 / 多机部署时这里填【第一台的地址】，两台填的是同一台机器。
#
#     填内网还是公网，是**拿前置条件换性能**的取舍：
#
#       内网 IP（云控制台「实例详情」→ 私有 IP）
#         更快、更安全、不计公网带宽；但要多一个「安全组放行内网互通」的前置条件。
#       公网 IP
#         现在就能用（3306 本来就对任意来源开放），少一个前置条件；
#         代价是流量出网卡绕一圈公网再回来。
#
#     ⚠️ 只有一个例外：**别填本机自己的公网 IP**。
#        那会走 NAT 回环（hairpin），多数云厂商默认不支持，表现是连不上。
#        两台不同的机器之间走公网没有这个问题。
#
#     本项目的实际选择与理由见 docs/12-集群部署清单.md 第零节。
#
#  ⚠️ 改成 IP 之后务必确认 MySQL 的账号授权范围：
#     账号是按 (user, host) 成对建的，root@'localhost'（走 socket）与
#     root@'<IP>'（走 TCP）是【两个不同的账号】，密码可以不一样。
#     报 Access denied 时先怀疑这一点，而不是密码打错了。
# ============================================================================
# ─────────────────────────────────────────────────────────────────────
#  ⚠️ 哪台机器该填什么，这是最容易搞错的一项：
#
#     第一台（MySQL 就和它同机）→ 【保持注释】，回落 127.0.0.1，最快最稳
#     第二台及以后（MySQL 在别的机器上）→ 【必须取消注释并填第一台的地址】
#
#  ⚠️⚠️ 第二台【绝不能填 127.0.0.1】—— 那是它自己，那儿没有数据库。
#      填错的表现是启动时报 Connection refused，
#      而你会以为是数据库没起来，跑去第一台查 mysqld，白折腾一轮。
# ─────────────────────────────────────────────────────────────────────
# DB_HOST='127.0.0.1'        # 不填 = 127.0.0.1
# DB_PORT='3306'             # 不填 = 3306
DB_USERNAME='root'
DB_PASSWORD='<改成真实密码>'


# ============================================================================
#  【必填】Redis
#
#  ⚠️ 生产用的是 database 2（在 application-prod.yml 里配的），
#     而本地 dev 用的是 database 0。两边连的是同一台 Redis，
#     不分库的话本地签发的登录 token 在生产会被认可，验证码 key 也会互相覆盖。
#
#  ⚠️ REDIS_HOST / REDIS_PORT 与 DB_HOST 同批占位符化（2026-09-15），
#     不填默认 127.0.0.1:6379。选地址的理由与 MySQL 完全一致。
#
#  ⚠️ 真要上 Redis Cluster 时 database 这一项要先重新想：
#     集群模式只有 database 0，「靠分库隔离 dev 与 prod」的做法会直接失效，
#     只能改成 key 前缀隔离 —— 那要动代码，不是改配置能解决的。
# ============================================================================
# ⚠️ REDIS_HOST 的填法与上面的 DB_HOST 完全一致：
#    第一台保持注释；第二台必须填第一台的地址，绝不能填 127.0.0.1。
#    ⚠️ 两台填的必须是【同一台机器】—— DB_HOST 和 REDIS_HOST 别串了。
# REDIS_HOST='127.0.0.1'     # 不填 = 127.0.0.1
# REDIS_PORT='6379'          # 不填 = 6379
REDIS_USERNAME='default'
REDIS_PASSWORD='<改成真实密码>'


# ============================================================================
#  【必填】163 邮箱 SMTP
#
#  ⚠️ MAIL_PASSWORD 填的是 163 的【SMTP 授权码】，不是邮箱登录密码！
#     获取路径：163 邮箱网页版 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 生成授权码
#
#  ⚠️⚠️ 用之前必须先在 163 网页版【开启 SMTP 服务】。
#      服务没开时，即使授权码完全正确，也一律返回
#      "535 Error: authentication failed" —— 错误信息完全指向"密码错"，
#      于是会一直去核对授权码，而真正的原因在那个网页开关上。
#
#  ⚠️ MAIL_USERNAME 必须是【完整邮箱地址】。163 用手机号注册的账号，
#     地址就是「手机号@163.com」。这个值同时被当作发件人 From 使用。
#
#  ⚠️ 163 每重置一次授权码，旧的立即失效 —— 换码后必须重启后端才生效。
# ============================================================================
MAIL_USERNAME='<xxx@163.com>'
MAIL_PASSWORD='<163 的 SMTP 授权码>'


# ============================================================================
#  【必填】阿里云 OSS
#
#  ⚠️⚠️ 这四项缺任何一个，应用都【启动不起来】。
#      OssConfig 会校验并抛 IllegalStateException。
#      这是有意为之：宁可启动时大声失败，也不要带空配置跑起来、
#      等用户第一次上传头像时才报错。
# ============================================================================
OSS_ENDPOINT='oss-cn-chengdu.aliyuncs.com'
OSS_ACCESS_KEY_ID='<AccessKeyId>'
OSS_ACCESS_KEY_SECRET='<AccessKeySecret>'
OSS_BUCKET_NAME='qk-files'


# ============================================================================
#  【必填】AI 小助手
#
#  ⚠️ AI_MODEL 必须是厂商真实存在的模型 ID，否则 AI 功能会在调用时失败。
#
#     deepseek-flash 这个名字【不在 DeepSeek 的公开模型列表里】
#     （公开的是 deepseek-chat / deepseek-reasoner），一度被怀疑写错了。
#     但 2026-09-15 在生产上实测【确实可用】，所以第一台用的就是它。
#
#     ⚠️ 两台机器必须填【同一个值】。别一台 flash 一台 chat ——
#        模型不同会让排障时的现象对不上，白白多一轮排查。
# ============================================================================
AI_MODEL='deepseek-flash'


# ============================================================================
#  【选填】以下留空或删掉都能正常启动
# ============================================================================

# DeepSeek API Key。
# ⚠️ 和 OSS 相反，这一项【留空不影响启动】：代码里对空 key 会降级处理，
#    AI 入口隐藏、接口返回 5006，其余功能完全正常。
DEEPSEEK_API_KEY=''

# OSS 对象 key 前缀，默认 crm/，最终路径形如 crm/product/2026/09/<uuid>.png
OSS_DIR='crm/'

# ⚠️ 换 CDN / 自定义域名用这个开关，不用改代码、不用重新打包。
#    留空 = 用 OSS 默认域名 https://{bucket}.{endpoint}/...
#    填了 = 文件访问 URL 直接用它当前缀，例如 https://cdn.example.com
OSS_URL_PREFIX=''


# ============================================================================
#  【选填】服务端口
#
#  默认 8080，一般【不用改】。留着这个开关是为了万一 8080 被别的项目占了，
#  能不改代码、不重新打包就换端口 —— 这台服务器上曾经就撞过一次。
#
#  ⚠️ 部署前先确认端口是空的：
#       ss -ltnp | grep 8080
#     这台机器上 22 / 80 / 1234 / 3306 / 6379 都被占用，别再选这些。
#
#  ⚠️ 这两项必须【成对修改】，端口和健康检查地址要对上。
#      只改一个的表现是：服务其实正常起来了，但脚本一直探测旧端口，
#      等满 180 秒后报"启动失败"，然后你去查日志却发现一切正常 —— 非常误导。
#
#  ⚠️ SERVER_PORT 是 Spring Boot 的内置环境变量名，会自动映射到
#     application-prod.yml 里的 server.port，【改它不用重新打包】。
# ============================================================================
SERVER_PORT='8080'
HEALTH_URL='http://127.0.0.1:8080/actuator/health'


# ============================================================================
#  【选填】其他脚本与 JVM 参数
# ============================================================================

# java 可执行文件。留空时脚本会自动去 /usr/local/jdk-17*/bin/java 找，
# 再退回 PATH 里的 java。找不到才需要显式指定。
# JAVA_BIN='/usr/local/jdk-17.0.13/bin/java'

# ⚠️ 堆大小必须给同机的 MySQL 和 Redis 留出余量。
#    不设 -Xmx 时 JVM 默认吃物理内存的 1/4，内存紧张时内核的 OOM killer
#    可能挑 MySQL 下手 —— 一次部署就变成一次数据库宕机。
#
#    参考值（按服务器总内存选，应用和 MySQL/Redis 同机的情况）：
#      2G  → -Xms512m -Xmx512m
#      4G  → -Xms1g   -Xmx1g
#      8G  → -Xms2g   -Xmx2g
#      16G → -Xms4g   -Xmx4g
#
#    另外几项的作用：
#      -Duser.timezone=Asia/Shanghai  防止服务器时区配错导致时间差 8 小时
#      -Dfile.encoding=UTF-8          防止日志和文件名里的中文乱码
#      HeapDumpOnOutOfMemoryError     OOM 时留个堆转储好排查
#      ⚠️ 堆转储里含客户数据，分析完记得删掉
JAVA_OPTS='-Xms512m -Xmx512m -XX:MaxMetaspaceSize=256m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -XX:+HeapDumpOnOutOfMemoryError'

# 优雅停机的等待上限（秒）。
# 120 = 30s（HTTP 在途请求）+ 60s（定时/异步线程池收尾）+ 30s（连接池关闭余量）
# STOP_TIMEOUT='120'

# 健康检查重试次数，每次间隔 2 秒。90 × 2 = 180 秒上限
# HEALTH_RETRIES='90'
