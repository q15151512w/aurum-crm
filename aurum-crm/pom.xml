<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aurum.crm</groupId>
    <artifactId>aurum-crm</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>aurum-crm</name>
    <description>企业级智能 CRM 系统</description>

    <modules>
        <module>crm-framework</module>
        <module>crm-module-system</module>
        <module>crm-module-crm</module>
        <module>crm-module-finance</module>
        <module>crm-module-bpm</module>
        <module>crm-server</module>
    </modules>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ========== 第三方版本集中在此，升级只改这里 ========== -->
        <spring.boot.version>3.3.5</spring.boot.version>
        <mybatis.plus.version>3.5.7</mybatis.plus.version>
        <sa.token.version>1.39.0</sa.token.version>
        <redisson.version>3.32.0</redisson.version>
        <knife4j.version>4.5.0</knife4j.version>
        <hutool.version>5.8.32</hutool.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <lombok.version>1.18.38</lombok.version>
        <druid.version>1.2.23</druid.version>
        <spring.security.crypto.version>6.3.4</spring.security.crypto.version>
        <aliyun.oss.version>3.17.4</aliyun.oss.version>
        <easyexcel.version>3.3.4</easyexcel.version>

        <!--
            构建插件版本必须显式声明：
            pluginManagement 里只写 configuration 不写 version，Maven 会去仓库
            解析插件版本（maven-metadata.xml），离线构建直接失败，且不同机器结果不可复现。
        -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ========== Spring Boot 官方 BOM ========== -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 本项目各模块 ========== -->
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-module-system</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-module-crm</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-module-finance</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.aurum.crm</groupId>
                <artifactId>crm-module-bpm</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ========== 持久层 ========== -->
            <!-- Spring Boot 3 必须用 spring-boot3-starter，普通 starter 不兼容 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>
            <!--
                注意：MyBatis-Plus 3.5.9 起才把 jsqlparser 拆成独立依赖
                （mybatis-plus-jsqlparser）。3.5.7 里它仍打包在 extension 中，
                所以这里不需要额外引入。若升级到 3.5.9+，需补上该依赖。
            -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ========== 认证 ========== -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa.token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa.token.version}</version>
            </dependency>
            <!-- 只用 BCrypt 加密工具，不引整个 Spring Security -->
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-crypto</artifactId>
                <version>${spring.security.crypto.version}</version>
            </dependency>

            <!-- ========== 分布式锁 ========== -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- ========== 接口文档 ========== -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- ========== 对象存储 ========== -->
            <!--
                阿里云 OSS SDK。用于 crm-module-system 的文件上传能力
                （接口文档 3.7 POST /system/file/upload），产品图片等附件都走它。
            -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.oss.version}</version>
            </dependency>

            <!-- ========== 工具 ========== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- Excel 导出（EasyExcel 3.x，底层 Apache POI 5.x），各模块按需显式引入 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 所有模块共享的测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
